# Phone deployment profile. build-images.sh parses only EIP_CVE_UID,
# EIP_CVE_GID, EIP_CVE_PLATFORM_ARCH, and EIP_CVE_IMAGE_TAG from this file for
# the controller-only source-attribution build; it never sources this file.
# The remaining values document the matching bootstrap/runtime profile.
EIP_CVE_ROOT=/data/eip-cve
EIP_CVE_UID=2000
EIP_CVE_GID=2000
EIP_CVE_DOCKER_GID=2000
EIP_CVE_KVM=absent
EIP_CVE_PLATFORM_ARCH=arm64
EIP_CVE_CHAT_SOCKET=/data/eip-cve/run/eip-cve-agent-chat.sock
EIP_CVE_BROKER_VOLUME=false
EIP_CVE_UI_BIND=127.0.0.1
EIP_CVE_UI_PORT=7171
EIP_CVE_IMAGE_TAG=phone

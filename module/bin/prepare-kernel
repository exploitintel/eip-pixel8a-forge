#!/system/bin/sh
# Copy one package-authorized kernel candidate into KernelSU's temporary
# directory. Persistent staging belongs to the locked install transaction.
set -u
set -f

PROGRAM=prepare-kernel
BUSYBOX=/data/adb/ksu/bin/busybox
CACHE_ROOT=/data/docker/downloads
SIDELOAD_ROOT=/data/local/tmp
MODDIR=${0%/*}
MODDIR=${MODDIR%/*}
INPUTS=$MODDIR/installer-inputs.tsv
WORK=
WORK_OWNED=0

fail() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  exit "${2:-1}"
}

bb() {
  "$BUSYBOX" "$@"
}

path_exists() {
  [ -e "$1" ] || [ -L "$1" ]
}

valid_sha256() {
  [ "${#1}" -eq 64 ] || return 1
  case "$1" in *[!0-9a-f]*) return 1 ;; esac
}

canonical_positive() {
  case "$1" in [1-9]* ) ;; *) return 1 ;; esac
  case "$1" in *[!0-9]*) return 1 ;; esac
}

valid_build_id() {
  case "$1" in
    ''|.*|*.|*..*|*[!A-Z0-9.]*) return 1 ;;
  esac
}

# Called by traps.
# shellcheck disable=SC2329
cleanup() {
  [ "$WORK_OWNED" = 1 ] || return 0
  case "$WORK" in "$TMPDIR/.eip-kernel-prepare.work") ;; *) return 0 ;; esac
  bb rm -rf "$WORK" 2>/dev/null || true
  WORK_OWNED=0
}

# Called by signal traps.
# shellcheck disable=SC2329
cleanup_signal() {
  SIGNAL_STATUS=$1
  trap - EXIT HUP INT TERM
  cleanup
  exit "$SIGNAL_STATUS"
}

file_identity() {
  IDENTITY_FILE=$1
  [ -f "$IDENTITY_FILE" ] && [ ! -L "$IDENTITY_FILE" ] || return 1
  IDENTITY_SIZE=$(bb stat -c '%s' "$IDENTITY_FILE" 2>/dev/null) || return 1
  canonical_positive "$IDENTITY_SIZE" || return 1
  IDENTITY_LINE=$(bb sha256sum "$IDENTITY_FILE" 2>/dev/null) || return 1
  IDENTITY_OLD_IFS=$IFS
  IFS=' '
  # Parse the fixed sha256sum record with pathname expansion disabled.
  # shellcheck disable=SC2086
  set -- $IDENTITY_LINE
  IFS=$IDENTITY_OLD_IFS
  [ "$#" -eq 2 ] && [ "$2" = "$IDENTITY_FILE" ] && valid_sha256 "$1" || return 1
  IDENTITY_HASH=$1
}

require_identity() {
  require_file=$1
  require_size=$2
  require_hash=$3
  file_identity "$require_file" || return 1
  [ "$IDENTITY_SIZE" = "$require_size" ] && [ "$IDENTITY_HASH" = "$require_hash" ]
}

hash_inputs() {
  file_identity "$INPUTS" || return 1
  INPUT_HASH=$IDENTITY_HASH
}

[ "$#" -eq 2 ] || fail 'usage: prepare-kernel BUILD_ID INSTALLER_INPUTS_SHA256' 2
BUILD_ID=$1
EXPECTED_INPUT_HASH=$2
valid_build_id "$BUILD_ID" || fail 'build ID has an unsafe form' 2
valid_sha256 "$EXPECTED_INPUT_HASH" || fail 'installer-input hash has an unsafe form' 2
[ -x "$BUSYBOX" ] || fail 'KernelSU BusyBox is unavailable'
[ "$(bb id -u 2>/dev/null || true)" = 0 ] || fail 'root is required' 2
case "${TMPDIR:-}" in /*) ;; *) fail 'TMPDIR must be an absolute directory' 2 ;; esac
case "$TMPDIR" in
  /|*/../*|*/..|*/./*|*/.|*[!A-Za-z0-9_./+-]*) fail 'TMPDIR has an unsafe form' 2 ;;
esac
[ -d "$TMPDIR" ] && [ ! -L "$TMPDIR" ] || fail 'TMPDIR must be a real directory'
RESOLVED_TMP=$(bb readlink -f "$TMPDIR" 2>/dev/null) || fail 'cannot resolve TMPDIR'
[ "$RESOLVED_TMP" = "$TMPDIR" ] || fail 'TMPDIR must be a canonical real directory'
[ -f "$INPUTS" ] && [ ! -L "$INPUTS" ] || fail 'installer inputs must be a regular file'

export LC_ALL=C
umask 077
hash_inputs || fail 'cannot hash installer inputs'
[ "$INPUT_HASH" = "$EXPECTED_INPUT_HASH" ] || fail 'installer inputs do not match preflight'
PINNED_INPUT_HASH=$INPUT_HASH

TAB=$(printf '\t')
# The selected BUILD and current-public BOOT_STATE records are already covered
# by install-preflight's complete grammar. Revalidate their local shape here so
# this helper never accepts an ambiguous candidate after that handoff.
# shellcheck disable=SC2016
KERNEL_RECORD=$(bb awk -F "$TAB" -v build="$BUILD_ID" '
  function positive(value) { return value ~ /^[1-9][0-9]*$/ }
  function hash(value) { return length(value) == 64 && value !~ /[^0-9a-f]/ }
  NR == 1 { if (NF != 1 || $1 != "INSTALLER_INPUTS_VERSION=1") exit 1; next }
  $1 == "BUILD" && $2 == build {
    if (NF != 13 || found_build++ || $13 != "Image-" build ".lz4") exit 1
    name = $13
  }
  $1 == "BOOT_STATE" && $2 == build && $3 == "current-public" {
    if (NF != 7 || found_kernel++ || !positive($4) || !hash($5) ||
        !positive($6) || !hash($7)) exit 1
    size = $4
    digest = $5
  }
  END {
    if (found_build != 1 || found_kernel != 1) exit 1
    print name "\t" size "\t" digest
  }
' "$INPUTS") || fail 'installer inputs do not select one kernel candidate'
hash_inputs || fail 'cannot rehash installer inputs'
[ "$INPUT_HASH" = "$PINNED_INPUT_HASH" ] || fail 'installer inputs changed during kernel selection'

OLD_IFS=$IFS
IFS=$TAB
# Parse the fixed three-field candidate record.
# shellcheck disable=SC2086
set -- $KERNEL_RECORD
IFS=$OLD_IFS
[ "$#" -eq 3 ] || fail 'kernel candidate record has an invalid shape'
IMAGE_NAME=$1
IMAGE_SIZE=$2
IMAGE_HASH=$3
canonical_positive "$IMAGE_SIZE" && valid_sha256 "$IMAGE_HASH" \
  || fail 'kernel candidate identity is malformed'

WORK=$TMPDIR/.eip-kernel-prepare.work
PREPARED=$TMPDIR/eip-kernel-prepared
path_exists "$WORK" && fail 'kernel preparation work path already exists'
path_exists "$PREPARED" && fail 'prepared kernel output already exists'
bb mkdir "$WORK" || fail 'cannot create kernel preparation work directory'
WORK_OWNED=1
trap cleanup EXIT
trap 'cleanup_signal 129' HUP
trap 'cleanup_signal 130' INT
trap 'cleanup_signal 143' TERM
bb chmod 0700 "$WORK" || fail 'cannot protect kernel preparation work directory'
bb chown 0:0 "$WORK" || fail 'cannot own kernel preparation work directory'

CACHE_FILE=$CACHE_ROOT/$IMAGE_NAME
SIDELOAD_FILE=$SIDELOAD_ROOT/$IMAGE_NAME
PRIVATE_COPY=$WORK/$IMAGE_NAME
ACQUISITION_SOURCE=
if path_exists "$CACHE_FILE"; then
  require_identity "$CACHE_FILE" "$IMAGE_SIZE" "$IMAGE_HASH" \
    || fail 'existing-host kernel cache has an unsafe type or wrong identity'
  bb cp "$CACHE_FILE" "$PRIVATE_COPY" || fail 'cannot copy verified kernel cache'
  ACQUISITION_SOURCE=cache
elif path_exists "$SIDELOAD_FILE"; then
  require_identity "$SIDELOAD_FILE" "$IMAGE_SIZE" "$IMAGE_HASH" \
    || fail 'sideloaded kernel image has an unsafe type or wrong identity'
  bb cp "$SIDELOAD_FILE" "$PRIVATE_COPY" || fail 'cannot copy verified sideloaded kernel image'
  ACQUISITION_SOURCE=sideload
else
  fail "kernel image is not available; sideload with: adb push $IMAGE_NAME $SIDELOAD_FILE"
fi
require_identity "$PRIVATE_COPY" "$IMAGE_SIZE" "$IMAGE_HASH" \
  || fail 'private kernel image copy has the wrong identity'
hash_inputs || fail 'cannot rehash installer inputs before publication'
[ "$INPUT_HASH" = "$PINNED_INPUT_HASH" ] || fail 'installer inputs changed during kernel preparation'
bb chmod 0600 "$PRIVATE_COPY" || fail 'cannot protect prepared kernel image'
bb chown 0:0 "$PRIVATE_COPY" || fail 'cannot own prepared kernel image'
bb mv -T "$PRIVATE_COPY" "$PREPARED" || fail 'cannot publish prepared kernel image'

printf '%s\n' \
  'KERNEL_PREPARE_VERSION=1' \
  "build_id=$BUILD_ID" \
  "acquisition_source=$ACQUISITION_SOURCE" \
  "prepared_path=$PREPARED" \
  "image_size=$IMAGE_SIZE" \
  "image_sha256=$IMAGE_HASH" \
  "installer_inputs_sha256=$PINNED_INPUT_HASH"
exit 0

# Minimal Docker delta over the stock Pixel 8a CP2A.260805.005 config.
CONFIG_SYSVIPC=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# Keep vendor-module layouts compatible with stock. Android 6.1 has no
# configurable protection list, so the gate itself must be disabled for the
# factory system and vendor modules to load against a rebuilt kernel.
# CONFIG_WERROR is not set
# CONFIG_MODULE_SIG_PROTECT is not set

# Match the factory vendor modules' vermagic exactly.
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-android14-11-gbd23337e42e7-ab14791245"
